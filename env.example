# Copy this file to `.env` at the repo root and fill in the values you have.
# `.env*` is gitignored — real tokens must never be committed.
#
#   cp env.example .env
#
# Only the marketing scripts read this file. The deployed site's secrets
# (GROQ_API_KEY, SHOPIFY_STOREFRONT_TOKEN, SHOPIFY_STORE_DOMAIN) live in
# Vercel's environment variables, not here.
#
# NOTE when setting Vercel env vars from a shell: always pipe with printf from
# Git Bash, never a PowerShell string pipe — PowerShell smuggles a UTF-8 BOM
# into the stored value and the resulting header throws at runtime. This has
# already broken the Groq key once.
#     printf '%s' 'the-value' | npx vercel env add NAME production


# ---------------------------------------------------------------- Pinterest
# developers.pinterest.com -> your app -> generate an access token.
# Scopes needed: boards:read, pins:read, pins:write
# Run `node scripts/social/pinterest-pin.js --check` to list board IDs.
# Reminder: on TRIAL access, created pins are NOT publicly visible and tokens
# expire after 24 hours. Standard access requires a second review.
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=


# ------------------------------------------------------- Facebook / Instagram
# developers.facebook.com -> your app. Requires Business Verification and
# App Review for pages_manage_posts + instagram_content_publish.
# Run `node scripts/social/meta-reel.js --check` to find META_IG_USER_ID.
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_USER_ID=
# Optional — only set this if Meta deprecates the default in the script.
META_API_VERSION=
